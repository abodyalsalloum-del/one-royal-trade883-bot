from telegram import Update, InlineKeyboardButton, InlineKeyboardMarkup, ReplyKeyboardMarkup
from telegram.ext import ContextTypes, ConversationHandler, CommandHandler, CallbackQueryHandler, MessageHandler, filters
from database import get_user, add_user
from languages import TEXTS

LANG_SELECT, REG_USERNAME, REG_PASSWORD = range(3)

def get_main_keyboard(lang: str):
    t = TEXTS[lang]
    keyboard = [
        [t['btn_profile'], t['btn_balance']],
        [t['btn_deposit'], t['btn_withdraw']],
        [t['btn_transactions'], t['btn_settings']],
        [t['btn_support']]
    ]
    return ReplyKeyboardMarkup(keyboard, resize_keyboard=True)

async def start_command(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user_id = update.effective_user.id
    user = get_user(user_id)
    if user and user['username']:
        lang = user['language']
        await update.message.reply_text(
            f"{TEXTS[lang]['main_menu']}",
            reply_markup=get_main_keyboard(lang)
        )
        return ConversationHandler.END

    keyboard = [
        [InlineKeyboardButton("العربية", callback_data="lang_ar")],
        [InlineKeyboardButton("English", callback_data="lang_en")]
    ]
    reply_markup = InlineKeyboardMarkup(keyboard)
    await update.message.reply_text(
        "Welcome to **One Royal AI Trading**\nاختر لغتك / Choose your language:",
        reply_markup=reply_markup,
        parse_mode="Markdown"
    )
    return LANG_SELECT

async def lang_choice(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    lang = "ar" if query.data == "lang_ar" else "en"
    context.user_data['lang'] = lang
    await query.edit_message_text(TEXTS[lang]['lang_selected'])
    await query.message.reply_text(TEXTS[lang]['enter_username'])
    return REG_USERNAME

async def process_username(update: Update, context: ContextTypes.DEFAULT_TYPE):
    username = update.message.text.strip()
    context.user_data['username'] = username
    lang = context.user_data.get('lang', 'ar')
    await update.message.reply_text(TEXTS[lang]['enter_password'])
    return REG_PASSWORD

async def process_password(update: Update, context: ContextTypes.DEFAULT_TYPE):
    password = update.message.text.strip()
    user_id = update.effective_user.id
    username = context.user_data['username']
    lang = context.user_data.get('lang', 'ar')

    add_user(user_id, username, password, lang)
    await update.message.reply_text(
        TEXTS[lang]['registration_complete'],
        reply_markup=get_main_keyboard(lang),
        parse_mode="Markdown"
    )
    return ConversationHandler.END

start_handler = ConversationHandler(
    entry_points=[CommandHandler('start', start_command)],
    states={
        LANG_SELECT: [CallbackQueryHandler(lang_choice, pattern='^lang_')],
        REG_USERNAME: [MessageHandler(filters.TEXT & ~filters.COMMAND, process_username)],
        REG_PASSWORD: [MessageHandler(filters.TEXT & ~filters.COMMAND, process_password)],
    },
    fallbacks=[CommandHandler('start', start_command)]
)
